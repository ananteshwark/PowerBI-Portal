# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --------------------------------------------------------------- database ---
DATABASE_URL=postgresql://portal:portal@localhost:5432/powerbi_portal
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ------------------------------------------------------------ portal auth ---
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_minimum_32_chars
JWT_ISSUER=powerbi-portal
JWT_AUDIENCE=powerbi-portal-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------------------------------------- Entra ID service principal -------
# From docs/AZURE_SETUP.md steps 1-2. NEVER commit real values.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# --------------------------------------------------------------- Power BI ---
POWERBI_API_BASE=https://api.powerbi.com/v1.0/myorg
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default
POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------- caching ---
# Refresh embed tokens this many seconds before expiry (server and client).
TOKEN_REFRESH_SKEW_SECONDS=300
# Required once you run more than one backend instance.
# REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------- CORS/cookies ---
# How many proxy hops to trust for req.ip, which drives the rate limiters and
# audit_log.ip_address. This is a security setting: trusting a hop that is not
# there lets any client forge X-Forwarded-For and rotate past the limiters.
#   false  - app is reachable directly (default, safe)
#   1      - exactly one proxy in front (single ALB / nginx / Container Apps)
#   <CIDR> - comma-separated trusted proxy ranges (e.g. Cloudflare)
TRUST_PROXY=false

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
